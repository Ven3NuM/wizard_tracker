{
  "name": "wizard-tracker-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "webapp",
    "app",
    "course"
  ],
  "scripts": {
    "dev": "npm run dev -w webapp",
    "build": "npm run build -w webapp",
    "preview": "npm run preview -w webapp",
    "test": "npm test -w webapp",
    "test:e2e": "npm run test:e2e -w webapp",
    "lesson": "npm run lesson -w course --",
    "lint": "eslint .",
    "app:build": "npm run build -w app",
    "app:open": "npm run open -w app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
